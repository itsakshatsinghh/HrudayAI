# ==============================================================================
# HrudayAI .gitignore
# Never commit credentials, private patient data, audio recordings,
# model weights, or generated datasets.
# ==============================================================================

# --- Credentials, Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/
*secret*.json
*credential*.json
service_account*.json
client_secret*.json
token*.json

# --- Private Patient Data & Generated Datasets ---
data/
datasets/
patient_data/
private_data/
phi/
raw_data/
processed_data/
generated_data/
outputs/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.sqlite
*.sqlite3
*.db
*.jsonl
*.ndjson
*.xlsx
*.xls
*.dcm
*.edf

# --- Audio Recordings ---
audio/
recordings/
voice_samples/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.opus
*.wma
*.webm
*.pcm
*.raw
*.amr

# --- Model Weights, Checkpoints & Experiment Caches ---
models/
weights/
checkpoints/
saved_models/
artifacts/
.huggingface/
hf_cache/
torch_cache/
wandb/
mlruns/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.tflite
*.pb
*.ckpt
*.gguf
*.ggml
*.pkl
*.pickle
*.joblib
*.model
*.npy
*.npz

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.installed.cfg
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter Notebooks & Google Colab ---
.ipynb_checkpoints/
*.nbconvert.ipynb
drive/

# --- Logs, Temp & OS / IDE Files ---
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
